    "%@  ·  %@. Bold, italic and underline on words are kept when the font changes." : {
      "comment" : "Inspector footer; placeholders are the word count and block count",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  %2$@. Fett, kursiv und unterstrichen bleiben beim Schriftwechsel erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@  ·  %2$@. Bold, italic and underline on words are kept when the font changes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  %2$@. La negrita, la cursiva y el subrayado se conservan al cambiar el tipo de letra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  %2$@. Le gras, l’italique et le souligné sont conservés lors d’un changement de police."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  %2$@。フォントを変更しても、ボールド、イタリック、アンダーラインは保持されます。"
          }
        }
      }
    },
