    "Applies to Add Sibling (⌘=), Add Child (⇧⌘=) and ⌘↩." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für „Block danach hinzufügen“ (⌘=), „Unterblock hinzufügen“ (⇧⌘=) und ⌘↩."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a «Añadir bloque después» (⌘=), «Añadir subbloque» (⇧⌘=) y ⌘↩."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à « Ajouter un bloc après » (⌘=), « Ajouter un sous-bloc » (⇧⌘=) et ⌘↩."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「後ろにブロックを追加」（⌘=）、「サブブロックを追加」（⇧⌘=）、⌘↩ に適用されます。"
          }
        }
      }
    },
    "Are you sure you want to delete the selected block? Its sub-blocks will be deleted with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du den ausgewählten Block wirklich löschen? Seine Unterblöcke werden mit gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar el bloque seleccionado? Sus subbloques se eliminarán con él."
