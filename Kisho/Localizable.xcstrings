    "Title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Título"
          }
        },
        "fr" : {
          "stringUnit" : {
